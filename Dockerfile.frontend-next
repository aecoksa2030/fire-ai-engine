# Multi-stage build for the Next.js frontend (replaces the Streamlit
# frontend/ service — see Dockerfile.frontend for the old one, kept
# around only until the cutover is confirmed working end to end).
FROM node:22-slim AS deps
WORKDIR /app
COPY frontend-next/package.json frontend-next/package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend-next/ .
# Baked in at build time — Next.js inlines NEXT_PUBLIC_* env vars into the
# client bundle during `next build`, so this must be a build ARG, not a
# runtime `environment:` entry in docker-compose (that would only affect
# `next start`'s server process, too late for anything already inlined
# into the JS shipped to the browser).
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
